PORT=8080
CLERK_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxx

# データベース接続
# Supabase 等のクラウド DB を利用する場合は、以下の DATABASE_URL 1本で指定可能です
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# ローカル Docker DB 接続設定 (DATABASE_URL が未設定の場合に利用されます)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=study_app
DB_SSLMODE=disable

# API キー暗号化マスターキー (32バイト / 64文字の16進数文字列)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef